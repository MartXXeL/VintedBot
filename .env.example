# Copia este archivo a ".env" y rellena lo que necesites.
# Todo lo que falte tiene un valor por defecto sensato o degrada a un modo
# simulado (la app arranca igual, sin credenciales, para poder probarla).

# --- Panel web -------------------------------------------------------------
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
# Usuario/hash se generan solos en el primer arranque si no existen.
DASHBOARD_USER=
DASHBOARD_PASSWORD_HASH=
DASHBOARD_FORCE_HTTPS=false

# --- Cifrado en reposo -------------------------------------------------------
# Clave Fernet para cifrar credenciales, sesiones de Vinted y precios mínimos
# guardados en la base de datos. Se genera sola si falta.
DB_ENCRYPTION_KEY=

# --- IA (Claude Sonnet 5, con visión) --------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Sin ANTHROPIC_API_KEY se usa un proveedor simulado (AI_PROVIDER=mock forzado).
AI_PROVIDER=auto

# --- Vinted ------------------------------------------------------------------
# Vía oficial (Vinted Pro Integrations) — si tienes acceso de vendedor profesional.
VINTED_API_BASE_URL=https://api.vinted.com
VINTED_API_CLIENT_ID=
VINTED_API_CLIENT_SECRET=
# Vía rápida (sesión de navegador) — sin formalización, más frágil.
VINTED_DOMAIN=www.vinted.es

# --- Ritmo seguro de automatización (protege tus propias cuentas) ----------
RATE_LIMIT_MIN_SECONDS=180
RATE_LIMIT_MAX_SECONDS=600
RATE_LIMIT_MAX_ACTIONS_PER_DAY=50
RATE_LIMIT_NIGHT_START_HOUR=23
RATE_LIMIT_NIGHT_END_HOUR=8

# --- Cumplimiento fiscal (DAC7) ----------------------------------------------
DAC7_ALERT_AMOUNT_EUR=2000
DAC7_ALERT_TRANSACTIONS=30

# --- Cobro (Stripe) ------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_ID=
STRIPE_PRICE_PRO_ID=
STRIPE_PRICE_SCALE_ID=

# --- Base de datos -------------------------------------------------------------
DATABASE_PATH=data/vintedbot.db
